# Unsaid - LM Studio Local AI Configuration
# Point to your local LM Studio instance (OpenAI-compatible server)
VITE_LM_STUDIO_BASE_URL=http://localhost:1234/v1

# (Optional) Model name to target. Leave empty to automatically use the currently loaded model in LM Studio.
# Examples: gemma-2-2b-it, gemma-2-9b-it, gemma-3-1b-it, etc.
VITE_LM_STUDIO_MODEL=
